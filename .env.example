# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Feeroute
APP_URL=http://localhost:3000
DATABASE_PATH=./data/feeroute.db

# Signs the admin session cookie. Use a long random string: openssl rand -hex 32
SESSION_SECRET=
# Password for /admin, where the dev records claims.
ADMIN_PASSWORD=
# Bearer token for /api/cron/* and the JSON admin API.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Chain (Robinhood Chain). Used by "Connect wallet" in the browser and as the default
# for every RPC below. NEXT_PUBLIC_* values are baked in at build time: rebuild after changing them.
# ─────────────────────────────────────────────────────────────────────────────
# Mainnet
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
# Testnet (faucet: https://faucet.testnet.chain.robinhood.com)
# NEXT_PUBLIC_CHAIN_ID=46630
# NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain Testnet
# NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
# NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# Explorer links in /admin. Defaults to $NEXT_PUBLIC_EXPLORER_URL/tx/{hash}.
EXPLORER_TX_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Fee economics
# ─────────────────────────────────────────────────────────────────────────────
# Share of every claim credited to the X account (basis points). The rest buys back and burns.
RECIPIENT_SHARE_BPS=8000
# A payout goes out each time an account's lifetime earnings cross one of these (USD),
# then every PAYOUT_MILESTONE_STEP_USD after the last. Each payout sends the full unpaid balance.
PAYOUT_MILESTONES_USD=5,10,20,50,100,250,500,1000
PAYOUT_MILESTONE_STEP_USD=1000

# ─────────────────────────────────────────────────────────────────────────────
# Claims (long.xyz chain)
# ─────────────────────────────────────────────────────────────────────────────
# manual  = the dev claims fees on long.xyz and records each claim in /admin (default).
# longxyz = fully automatic claiming through the fee contract below.
FEE_SOURCE=manual

# RPC for the chain long.xyz runs on. Used to verify claim transactions and wallet signatures,
# read token names and symbols, and (in longxyz mode) to claim. Defaults to NEXT_PUBLIC_RPC_URL.
# A dedicated RPC provider is recommended in production.
LONG_RPC_URL=
LONG_CHAIN_ID=
# Treasury that tokens name as their creator-fee beneficiary. Shown on /launch.
TREASURY_ADDRESS=

# Only for FEE_SOURCE=longxyz. Check every value against long.xyz's deployed contracts.
TREASURY_PRIVATE_KEY=
LONG_FEE_CONTRACT=
LONG_LAUNCH_EVENT=event TokenCreated(address indexed token, address indexed creator, string tokenURI)
LONG_CLAIMABLE_FN=function claimable(address token, address beneficiary) view returns (uint256)
LONG_CLAIM_FN=function claim(address token) returns (uint256)
LONG_TOKEN_URI_FN=function tokenURI() view returns (string)
LONG_FROM_BLOCK=0
LONG_FEE_ASSET_DECIMALS=18
LONG_FEE_ASSET_USD=1

# ─────────────────────────────────────────────────────────────────────────────
# Payouts
# ─────────────────────────────────────────────────────────────────────────────
# erc20   = automatic: sends a USD stablecoin to the wallet each account linked on /wallet.
# webhook = automatic: POSTs each payout (HMAC-signed) to your own payout service, e.g. an X Money bridge.
# manual  = payouts queue up and the admin settles them by hand.
PAYOUT_PROVIDER=erc20

# erc20 provider. Chain defaults to LONG_RPC_URL / LONG_CHAIN_ID.
# Use the stablecoin contract on Robinhood Chain and check its address on the explorer.
PAYOUT_RPC_URL=
PAYOUT_CHAIN_ID=
PAYOUT_TOKEN_ADDRESS=
PAYOUT_TOKEN_DECIMALS=6
# Hot wallet holding only the stablecoin float for payouts (plus gas). Never the treasury key.
PAYOUT_PRIVATE_KEY=

# webhook provider.
PAYOUT_WEBHOOK_URL=
PAYOUT_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Profile pictures
# ─────────────────────────────────────────────────────────────────────────────
# {handle} is the placeholder; empty = initials only.
NEXT_PUBLIC_AVATAR_URL_TEMPLATE=https://unavatar.io/x/{handle}
