# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=LongPaid
APP_URL=http://localhost:3000
DATABASE_PATH=./data/longpaid.db

# Signs the admin session cookie. Use a long random string: openssl rand -hex 32
SESSION_SECRET=
# Password for /admin, where the dev records claims.
ADMIN_PASSWORD=
# Bearer token for /api/cron/* and the JSON admin API.
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Launchpad and network: stonkfun.xyz on Solana
# Creators launch on stonkfun.xyz, send the creator fees to LONGPAID_FEE_WALLET and write
# "fees @handle" in the bio. The dev claims the fees and records each claim in /admin.
# ─────────────────────────────────────────────────────────────────────────────
LAUNCHPAD_NAME=stonkfun.xyz
LAUNCHPAD_URL=https://www.stonkfun.xyz
LAUNCHPAD_LAUNCH_URL=https://www.stonkfun.xyz/launch
NEXT_PUBLIC_CHAIN_NAME=Solana
NEXT_PUBLIC_EXPLORER_URL=https://solscan.io
# LongPaid's Solana wallet that receives the creator fees. Shown on /launch and /docs.
LONGPAID_FEE_WALLET=
# Confirms claim and burn transactions and that a mint exists. A dedicated RPC is recommended.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Launch form on /launch: the user's own wallet signs and pays stonkfun; this server only relays to stonkfun's API.
# 0 turns the form off.
LAUNCH_ON_SITE=1
STONKFUN_API_URL=https://www.stonkfun.xyz/api/public/v1

# Explorer links in /admin. Defaults to $NEXT_PUBLIC_EXPLORER_URL/tx/{hash}.
EXPLORER_TX_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Fee economics
# ─────────────────────────────────────────────────────────────────────────────
# Share of every claim credited to the X account (basis points). The rest buys back and burns.
RECIPIENT_SHARE_BPS=8000
# A payout goes out each time an account's lifetime earnings cross one of these (USD),
# then every PAYOUT_MILESTONE_STEP_USD after the last. Each payout sends the full unpaid balance.
PAYOUT_MILESTONES_USD=5,10,20,50,100,250,500,1000
PAYOUT_MILESTONE_STEP_USD=1000

# ─────────────────────────────────────────────────────────────────────────────
# Claims (legacy EVM settings; unused on Solana)
# ─────────────────────────────────────────────────────────────────────────────
# manual  = the dev claims fees on long.xyz and records each claim in /admin (default).
# longxyz = fully automatic claiming through the fee contract below.
FEE_SOURCE=manual

# RPC for the chain long.xyz runs on. Used to verify claim transactions and wallet signatures,
# read token names and symbols, and (in longxyz mode) to claim. Defaults to NEXT_PUBLIC_RPC_URL.
# A dedicated RPC provider is recommended in production.
LONG_RPC_URL=
LONG_CHAIN_ID=
# Treasury that tokens name as their creator-fee beneficiary. Shown on /launch.
TREASURY_ADDRESS=

# Only for FEE_SOURCE=longxyz. Check every value against long.xyz's deployed contracts.
TREASURY_PRIVATE_KEY=
LONG_FEE_CONTRACT=
LONG_LAUNCH_EVENT=event TokenCreated(address indexed token, address indexed creator, string tokenURI)
LONG_CLAIMABLE_FN=function claimable(address token, address beneficiary) view returns (uint256)
LONG_CLAIM_FN=function claim(address token) returns (uint256)
LONG_TOKEN_URI_FN=function tokenURI() view returns (string)
LONG_FROM_BLOCK=0
LONG_FEE_ASSET_DECIMALS=18
LONG_FEE_ASSET_USD=1

# ─────────────────────────────────────────────────────────────────────────────
# LongPaid's X account. Creators tag it with their token address; payouts go out from its X Money balance.
LONGPAID_X_HANDLE=uselongpaid

# ─────────────────────────────────────────────────────────────────────────────
# Optional, legacy: scanning launches on app.long.xyz (Robinhood Chain, EVM).
# Off unless LONGPAID_FEE_WALLETS is set.
# ─────────────────────────────────────────────────────────────────────────────
# The long.xyz wallet(s) of LONGPAID_X_HANDLE, comma-separated. Empty = off.
LONGPAID_FEE_WALLETS=
# long.xyz's LongLaunchFactory (signature-gated launch router).
LONG_FACTORY_ADDRESS=0x1Eef016F22A943abC7DD11422EDeE9D235942104
# First block to scan on a fresh database. Empty = start from the current block.
LONG_FACTORY_START_BLOCK=
# How often the web process scans (ms). 0 = off; use POST /api/cron/sync-launches instead.
LONG_SYNC_INTERVAL_MS=120000
# Gateways for ipfs:// metadata, tried in order.
IPFS_GATEWAYS=https://ipfs.io/ipfs/,https://dweb.link/ipfs/

# ─────────────────────────────────────────────────────────────────────────────
# Payouts
# ─────────────────────────────────────────────────────────────────────────────
# xmoney  = (default) paid in dollars through X Money to each @handle, from LongPaid's pre-funded X Money balance.
#           X Money has no public API: payouts queue in /admin → "Send on X Money" and the operator sends them in the X app.
# erc20   = automatic: sends a USD stablecoin to the wallet each account linked on /wallet.
# webhook = automatic: POSTs each payout (HMAC-signed) to your own payout service, e.g. an X Money bridge.
# manual  = payouts queue up and the admin settles them by hand.
PAYOUT_PROVIDER=xmoney

# erc20 provider. Chain defaults to LONG_RPC_URL / LONG_CHAIN_ID.
# Use the stablecoin contract on Robinhood Chain and check its address on the explorer.
PAYOUT_RPC_URL=
PAYOUT_CHAIN_ID=
PAYOUT_TOKEN_ADDRESS=
PAYOUT_TOKEN_DECIMALS=6
# Hot wallet holding only the stablecoin float for payouts (plus gas). Never the treasury key.
PAYOUT_PRIVATE_KEY=

# webhook provider.
PAYOUT_WEBHOOK_URL=
PAYOUT_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Profile pictures
# ─────────────────────────────────────────────────────────────────────────────
# {handle} is the placeholder; empty = initials only.
NEXT_PUBLIC_AVATAR_URL_TEMPLATE=https://unavatar.io/x/{handle}
